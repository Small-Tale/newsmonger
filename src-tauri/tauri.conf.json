{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Newsmonger",
  "version": "0.5.0",
  "identifier": "com.smalltale.newsmonger",
  "build": {
    "beforeDevCommand": "npm run build:client",
    "beforeBuildCommand": "bash scripts/build-sidecar.sh",
    "frontendDist": "loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Newsmonger",
        "hiddenTitle": true,
        "width": 960,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/newsmonger-node"
    ],
    "resources": [
      "server"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1MTNCMUFBQUZBRTc0ODQKUldTRWRLNnZxckVUWmF1ZW95eDQvUTE5OVB1bVBUQk9VaHhTc2wxQTVhU0NVdUNaOWxwcjMxdnQK",
      "endpoints": [
        "https://github.com/Small-Tale/newsmonger/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
