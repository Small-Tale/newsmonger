{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Newsmonger",
  "version": "0.1.0",
  "identifier": "com.brianwestphal.newsmonger",
  "build": {
    "beforeDevCommand": "npm run build:client",
    "beforeBuildCommand": "bash scripts/build-sidecar.sh \"$TAURI_ENV_TARGET_TRIPLE\"",
    "frontendDist": "loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Newsmonger",
        "width": 960,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/newsmonger-node"
    ],
    "resources": [
      "server"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}
